# Run ./setup.sh. It creates .env with new random secrets and never overwrites it.
COMPOSE_PROJECT_NAME=open-webui-stack
TZ=UTC
OPEN_WEBUI_PORT=13000
LITELLM_PORT=14000
WEBUI_URL=http://localhost:13000
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_NAME=Admin
POSTGRES_PASSWORD=GENERATE_ME
WEBUI_DB_PASSWORD=GENERATE_ME
LITELLM_DB_PASSWORD=GENERATE_ME
WEBUI_SECRET_KEY=GENERATE_ME
WEBUI_ADMIN_PASSWORD=GENERATE_ME
QDRANT_API_KEY=GENERATE_ME
LITELLM_MASTER_KEY=GENERATE_ME
LITELLM_SALT_KEY=GENERATE_ME
LITELLM_UI_PASSWORD=GENERATE_ME
OPEN_TERMINAL_API_KEY=GENERATE_ME
# Normally configured through Open WebUI Admin Settings after creating a virtual key.
LITELLM_WEBUI_KEY=
# Optional profiles: comma-separated proxy,ollama,terminal. Browsers are separate add-ons.
COMPOSE_PROFILES=
PROXY_BIND=127.0.0.1
PROXY_HTTP_PORT=18080
PROXY_HTTPS_PORT=18443
PROXY_ADMIN_PORT=18081
# Image overrides are optional. Default core image digests are pinned in compose.yaml.
# OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:YOUR_TESTED_RELEASE
# POSTGRES_IMAGE=postgres:16
# LITELLM_IMAGE=ghcr.io/berriai/litellm:YOUR_TESTED_RELEASE
# QDRANT_IMAGE=qdrant/qdrant:YOUR_TESTED_RELEASE
# TIKA_IMAGE=apache/tika:YOUR_TESTED_RELEASE
# NPM_IMAGE=jc21/nginx-proxy-manager:2.15.1
# OLLAMA_IMAGE=ollama/ollama:YOUR_TESTED_RELEASE
# OPEN_TERMINAL_IMAGE=ghcr.io/open-webui/open-terminal:YOUR_TESTED_RELEASE
